import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  vus: {{ current_vus }},
  duration: '{{ k6_test_duration }}',

  summaryTrendStats: [
     'avg',
    'p(5)',
    'p(25)',
    'med',
    'p(75)',
    'p(95)',
    'p(99)',
  ],
};

const targetUrl =
  'http://{{ test_target_host }}:{{ current_endpoint.port }}{{ current_endpoint.path }}';

export default function () {
  const response = http.get(targetUrl);

  check(response, {
    'HTTP response successful': (r) =>
      r.status >= 200 && r.status < 400,
  });

  sleep({{ k6_sleep_seconds }});
}
